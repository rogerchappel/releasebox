{
  "name": "releaseforge",
  "version": "0.1.0",
  "description": "Issue-driven release readiness tooling for OSS CLIs and apps.",
  "type": "module",
  "bin": {
    "releaseforge": "./bin/releaseforge.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "smoke": "npm run build && node bin/releaseforge.js --help && node bin/releaseforge.js --version"
  },
  "keywords": [
    "release",
    "github-actions",
    "oss",
    "cli",
    "continuous-release"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
