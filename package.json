{
  "name": "releasebox",
  "version": "0.1.0",
  "description": "Continuous release readiness tooling for OSS CLIs and apps.",
  "type": "module",
  "bin": {
    "releasebox": "./bin/releasebox.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "smoke": "npm run build && node bin/releasebox.js --help && node bin/releasebox.js --version",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs .",
    "release:check": "npm run lint && npm test && npm run smoke && npm run package:smoke && npm pack --dry-run",
    "release:notes": "node bin/releasebox.js notes"
  },
  "keywords": [
    "release",
    "github-actions",
    "oss",
    "cli",
    "continuous-release"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/releasebox.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/releasebox/issues"
  },
  "homepage": "https://github.com/rogerchappel/releasebox#readme",
  "packageManager": "npm@11.6.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
